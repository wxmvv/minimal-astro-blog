---
import { getCollection } from 'astro:content';
import CmdkSearch from './cmdkSearch.tsx';
import { siteMetadata } from '@data/config/site';

const searchEnabled = siteMetadata.search.provider === 'cmdk';
const posts = searchEnabled
  ? (await getCollection('blog', ({ data }) => !data.draft))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
      .map(({ id, data }) => ({
        href: `/blog/${id}/`,
        title: data.title,
        description: data.description ?? '',
        tags: data.tags,
      }))
  : [];
---

<header class="flex items-center justify-between" data-site-header transition:persist="site-header">
  <div class="mb-8 flex flex-row gap-4">
    <a href="/" aria-label={siteMetadata.title}>
      <div class="flex items-center justify-between">
        <div class="group grid h-8 w-8">
          <img src="/avatar.png" alt="描述图片" width={40} height={40} />
        </div>
      </div>
    </a>
  </div>
  {
    searchEnabled && (
      <CmdkSearch
        client:load
        showTrigger={false}
        posts={posts}
        config={siteMetadata.search.cmdkConfig}
      />
    )
  }
</header>
