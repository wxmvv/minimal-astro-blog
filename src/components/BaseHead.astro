---
import '@/styles/global.css';
import FallbackImage from '@data/assets/blog-placeholder-1.jpg';
// import { Font } from 'astro:assets';
import { siteMetadata, type PageMeta } from '@data/config/site';

interface Props {
  meta?: PageMeta;
}

const { meta = {} } = Astro.props;
const siteURL = Astro.site ?? new URL(siteMetadata.siteUrl);
const canonicalURL = new URL(meta.canonical ?? Astro.url.pathname, siteURL);
const title = meta.title ? `${meta.title} | ${siteMetadata.title}` : siteMetadata.title;
const description = meta.description ?? siteMetadata.description;
const image = meta.image ?? FallbackImage;
const imagePath = typeof image === 'string' || image instanceof URL ? image : image.src;
const imageURL = new URL(imagePath, siteURL);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
<!-- <link rel="icon" href="/favicon.ico" /> -->
<link rel="icon" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={siteMetadata.title}
  href={new URL(siteMetadata.rssPath, siteURL)}
/>
<meta name="generator" content={Astro.generator} />
{meta.noIndex && <meta name="robots" content="noindex,nofollow" />}

<!-- Font -->
<!-- <Font cssVariable="--font-atkinson" preload /> -->
<!-- 在css中使用 font-family: var(--font-atkinson); -->

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={meta.type ?? 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:locale" content={siteMetadata.locale.replace('-', '_')} />
<meta property="og:site_name" content={siteMetadata.title} />
{
  meta.publishedTime && (
    <meta property="article:published_time" content={meta.publishedTime.toISOString()} />
  )
}
{
  meta.updatedTime && (
    <meta property="article:modified_time" content={meta.updatedTime.toISOString()} />
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
