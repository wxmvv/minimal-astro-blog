---
import '@/styles/style.css';
// import FallbackImage from '@data/assets/blog-placeholder-1.jpg';
// import { Font } from 'astro:assets';
import { siteMetadata, type PageMeta } from '@data/config/site';

interface Props {
  meta?: PageMeta;
}

const { meta = {} } = Astro.props;
const siteURL = Astro.site ?? new URL(siteMetadata.siteUrl);
const canonicalURL = new URL(meta.canonical ?? Astro.url.pathname, siteURL);
const title = meta.title ? `${meta.title} | ${siteMetadata.title}` : siteMetadata.title;
const description = meta.description ?? siteMetadata.description;
// const image = meta.image ?? FallbackImage;
const image = meta.image;
const imageURL = image ? new URL(image, siteURL) : undefined;
const analytics: { umamiAnalytics?: { umamiWebsiteId: string; src: string } } =
  siteMetadata.analytics;
const umami = analytics.umamiAnalytics;
---

<!-- Native light/dark themes already cover this site. Avoid rewriting glass SVG filters. -->
<meta name="darkreader-lock" />

<script>
  // Dark Reader's early fallback injector does not check darkreader-lock.
  // Remove only that fallback if it is left behind or reinserted on theme changes.
  const removeDarkReaderFallback = () => {
    if (!document.head.querySelector('meta[name="darkreader-lock"]')) return;
    document.querySelectorAll('style.darkreader--fallback').forEach((style) => style.remove());
  };
  const fallbackObserver = new MutationObserver(removeDarkReaderFallback);
  // The extension can initially append its fallback to <html>, then move it to <head>.
  fallbackObserver.observe(document.documentElement, { childList: true });
  fallbackObserver.observe(document.head, { childList: true, subtree: true });
  removeDarkReaderFallback();
</script>

{
  import.meta.env.PROD && umami?.umamiWebsiteId && (
    <script is:inline defer src={umami.src} data-website-id={umami.umamiWebsiteId} />
  )
}

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
<!-- <link rel="icon" href="/favicon.ico" /> -->
<link rel="icon" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={siteMetadata.title}
  href={new URL(siteMetadata.rssPath, siteURL)}
/>
<meta name="generator" content={Astro.generator} />
{meta.noIndex && <meta name="robots" content="noindex,nofollow" />}

<!-- Font -->
<!-- <Font cssVariable="--font-atkinson" preload /> -->
<!-- 在css中使用 font-family: var(--font-atkinson); -->

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={meta.type ?? 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{imageURL && <meta property="og:image" content={imageURL} />}
<meta property="og:locale" content={siteMetadata.locale.replace('-', '_')} />
<meta property="og:site_name" content={siteMetadata.title} />
{
  meta.publishedTime && (
    <meta property="article:published_time" content={meta.publishedTime.toISOString()} />
  )
}
{
  meta.updatedTime && (
    <meta property="article:modified_time" content={meta.updatedTime.toISOString()} />
  )
}

<!-- Twitter -->
<meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageURL && <meta name="twitter:image" content={imageURL} />}
