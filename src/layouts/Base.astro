---
import { siteMetadata, type PageMeta } from '@data/config/site';
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import PageTransitions from '@/components/PageTransitions.astro';

interface Props {
  meta?: PageMeta;
  motionProfile?: 'list' | 'stagger';
}

const { meta = {}, motionProfile = 'stagger' } = Astro.props;

import AudioPlayer from '@/components/AudioPlayer/AudioPlayer.astro';

// Resolve config-relative assets through Vite so nested pages and builds use the same URLs.
const assets = import.meta.glob<string>('/data/assets/**/*.{mp3,wav,ogg,m4a,aac,flac,opus,webm}', {
  eager: true,
  query: '?url',
  import: 'default',
});
const audioTracks = siteMetadata.audioPlayer.trackList.map((track) => ({
  ...track,
  src: track.url.startsWith('../assets/')
    ? (assets[track.url.replace('../assets/', '/data/assets/')] ?? '')
    : track.url,
}));
---

<!doctype html>
<html lang={siteMetadata.language}>
  <head>
    <BaseHead meta={meta} />
    <PageTransitions />
    <slot name="head" />
  </head>
  <body>
    <div id="body-container">
      <Header />
      <div id="main-container" data-motion-profile={motionProfile}>
        <slot />
      </div>
      <Footer />
    </div>
    {
      !siteMetadata.audioPlayer?.hidden && (
        <AudioPlayer trackList={audioTracks} autoPlay={siteMetadata.audioPlayer.autoPlay} />
      )
    }
  </body>
</html>
