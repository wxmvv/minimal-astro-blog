---
import { siteMetadata, type PageMeta } from '@data/config/site';
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import PageTransitions from '@/components/PageTransitions.astro';

interface Props {
  meta?: PageMeta;
}

const { meta = {} } = Astro.props;
---

<!doctype html>
<html lang={siteMetadata.language}>
  <head>
    <BaseHead meta={meta} />
    <PageTransitions />
    <slot name="head" />
  </head>
  <body>
    <div id="body-container">
      <Header />
      <div
        id="main-container"
        data-motion-profile={Astro.url.pathname.replace(/\/$/, '') === '/blog' ? 'list' : 'stagger'}
      >
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>
