---
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import { projects } from '@data/config/projects';
import { pageMetadata } from '@data/config/site';
import BaseLayout from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import SiteTitle from '@/components/SiteTitle.astro';

const images = import.meta.glob<ImageMetadata>(
  '/data/assets/**/*.{png,jpg,jpeg,webp,avif,gif,svg}',
  {
    eager: true,
    import: 'default',
  },
);

function getProjectImage(path: string): ImageMetadata {
  // Resolve paths relative to data/config/projects.ts.
  const image = images[path.replace(/^\.\.\//, '/data/')];
  if (!image) throw new Error(`Project image not found: ${path}`);
  return image;
}

const projectImages = await Promise.all(
  projects.map(async ({ image }) => {
    if (!image) return undefined;
    const light = typeof image === 'string' ? image : image.light;
    const dark = typeof image === 'string' ? undefined : image.dark;
    return {
      light: /^https?:\/\//i.test(light) ? light : getProjectImage(light),
      dark: dark
        ? /^https?:\/\//i.test(dark)
          ? { src: dark, attributes: { width: undefined, height: undefined } }
          : await getImage({ src: getProjectImage(dark) })
        : undefined,
    };
  }),
);
---

<BaseLayout meta={pageMetadata.projects}>
  <SiteTitle />
  <Nav />
  <main>
    <ul class="section-g6 grid gap-6 md:grid-cols-2 md:-mx-24">
      {
        projects.map((project, index) => {
          const image = projectImages[index];
          return (
            <li class="section-g2 min-w-0" data-motion-item>
              {image && (
                <div class="flex min-w-0 flex-row justify-center bg-zinc-100 dark:bg-zinc-950 border-zinc-100 dark:border-zinc-950 rounded-sm aspect-square overflow-hidden">
                  <picture class="flex">
                    {image.dark && (
                      <source
                        media="(prefers-color-scheme: dark)"
                        srcset={image.dark.src}
                        width={image.dark.attributes.width}
                        height={image.dark.attributes.height}
                      />
                    )}
                    {typeof image.light === 'string' ? (
                      <img
                        src={image.light}
                        alt={project.title}
                        class="object-cover w-full h-full"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <Image
                        src={image.light}
                        alt={project.title}
                        class="object-cover"
                        loading="lazy"
                      />
                    )}
                  </picture>
                </div>
              )}
              <article>
                <h2>
                  {project.href ? (
                    <a target="_blank" href={project.href}>
                      {project.title}
                    </a>
                  ) : (
                    project.title
                  )}
                </h2>
                {project.year && <p class="text-zz">{project.year}</p>}
                {project.tag && <p class="text-zz">{project.tag}</p>}
                <p class="text-zz">{project.description}</p>
              </article>
            </li>
          );
        })
      }
    </ul>
  </main>
</BaseLayout>
